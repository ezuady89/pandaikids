# Set this only when publishing to a GitHub project page, for example /pandaikids.
NEXT_PUBLIC_BASE_PATH=

# Connection to Neon PostgreSQL. Set this in Vercel as a Secret; never commit its value.
DATABASE_URL=

# Google OAuth Web client used to verify DELIMa (@moe-dl.edu.my) accounts.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Server-only secret used to sign teacher login sessions. Use at least 32 random characters.
PANDAIKIDS_SESSION_SECRET=

# Public production origin used in ToyyibPay return and callback URLs.
PANDAIKIDS_APP_URL=https://www.pandaikids.com

# ToyyibPay credentials. Keep the secret key server-side only.
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Use https://dev.toyyibpay.com when testing with ToyyibPay Sandbox.
TOYYIBPAY_API_URL=https://toyyibpay.com

# Gemini API (Google AI Studio). Keep the real key in Vercel, never in Git.
GEMINI_API_KEY=

# Optional override for the direct Gemini model.
PANDAIKIDS_GEMINI_MODEL=gemini-3.5-flash-lite
